{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "InferenceJobConfig",
  "description": "Configuration for a vLLM batch inference job (stub — not yet implemented).",
  "type": "object",
  "required": ["model_path"],
  "additionalProperties": false,
  "properties": {
    "model_path": {
      "type": "string",
      "description": "HuggingFace model path or local path"
    },
    "input_path": {
      "type": "string",
      "description": "Path to input data (JSONL)"
    },
    "output_path": {
      "type": "string",
      "description": "Path to write inference results"
    },
    "max_tokens": {
      "type": "integer",
      "minimum": 1,
      "description": "Maximum tokens to generate per request"
    },
    "temperature": {
      "type": "number",
      "minimum": 0,
      "description": "Sampling temperature"
    }
  }
}
