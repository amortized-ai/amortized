{
  "$schema": "https://opencode.ai/config.json",
  "model": "google-vertex-anthropic/claude-opus-4-8@default",
  "mcp": {
    "amortized": {
      "type": "remote",
      "url": "http://amortized-server.amortized.svc.cluster.local:8000/mcp",
      "enabled": true
    }
  },
  "permission": { "skill": { "*": "allow" } },
  "agent": {
    "build": { "disable": true },
    "plan": { "disable": true },
    "sdg": { "permission": { "skill": { "sdg-*": "allow", "*": "deny" } } },
    "training": { "permission": { "skill": { "training-*": "allow", "*": "deny" } } }
  }
}
