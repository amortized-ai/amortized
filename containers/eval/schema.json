{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EvalJobConfig",
  "description": "Configuration for an LLM-as-judge evaluation job (stub — not yet implemented).",
  "type": "object",
  "required": ["model_path", "dataset_path"],
  "additionalProperties": false,
  "properties": {
    "model_path": {
      "type": "string",
      "description": "Path to the model to evaluate"
    },
    "dataset_path": {
      "type": "string",
      "description": "Path to the evaluation dataset"
    },
    "judge_model": {
      "type": "string",
      "description": "Judge model name (e.g. openai/gpt-4o)"
    },
    "judge_api_base": {
      "type": "string",
      "description": "Judge model API base URL"
    },
    "judge_api_key": {
      "type": "string",
      "description": "Judge model API key"
    }
  }
}
