# Amortized Runtime — Development image (no CUDA required)
#
# Lightweight image for local development with hot-reload.

FROM python:3.11-slim

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends curl \
    && rm -rf /var/lib/apt/lists/*

COPY server/ /app/server/
RUN pip install --no-cache-dir -e /app/server/

RUN mkdir -p /app/data

ENV AMORTIZED_DATA_DIR=/app/data
ENV PYTHONUNBUFFERED=1

EXPOSE 8000

CMD ["uvicorn", "amortized.main:app", "--host", "0.0.0.0", "--port", "8000", "--reload", "--reload-dir", "/app/server/src"]
