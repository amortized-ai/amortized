{
  "openapi": "3.1.0",
  "info": {
    "title": "Amortized",
    "description": "Control plane for building task models",
    "version": "1.0.0"
  },
  "paths": {
    "/api/v1/jobs": {
      "post": {
        "tags": [
          "jobs"
        ],
        "summary": "Create Job",
        "operationId": "create_job",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/JobRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Job"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      },
      "get": {
        "tags": [
          "jobs"
        ],
        "summary": "Get Jobs",
        "operationId": "list_jobs",
        "parameters": [
          {
            "name": "status",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "$ref": "#/components/schemas/JobStatus"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Status"
            }
          },
          {
            "name": "type",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "$ref": "#/components/schemas/JobType"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Type"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Job"
                  },
                  "title": "Response List Jobs"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/jobs/{job_id}": {
      "get": {
        "tags": [
          "jobs"
        ],
        "summary": "Get Job Detail",
        "operationId": "get_job",
        "parameters": [
          {
            "name": "job_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Job Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Job"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": [
          "jobs"
        ],
        "summary": "Cancel Job",
        "operationId": "cancel_job",
        "parameters": [
          {
            "name": "job_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Job Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Job"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/jobs/{job_id}/logs": {
      "get": {
        "tags": [
          "jobs"
        ],
        "summary": "Get Job Logs",
        "operationId": "get_job_logs",
        "parameters": [
          {
            "name": "job_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Job Id"
            }
          },
          {
            "name": "tail",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 100,
              "title": "Tail"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true,
                  "title": "Response Get Job Logs"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/jobs/{job_id}/artifacts": {
      "get": {
        "tags": [
          "jobs"
        ],
        "summary": "Get Job Artifacts",
        "description": "Return MLflow artifact URI for a completed job.",
        "operationId": "get_job_artifacts",
        "parameters": [
          {
            "name": "job_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Job Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true,
                  "title": "Response Get Job Artifacts"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/recipes": {
      "get": {
        "tags": [
          "recipes"
        ],
        "summary": "Get Recipes",
        "operationId": "list_recipes",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/RecipeSummary"
                  },
                  "type": "array",
                  "title": "Response List Recipes"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/recipes/{name}": {
      "get": {
        "tags": [
          "recipes"
        ],
        "summary": "Get Recipe",
        "operationId": "get_recipe",
        "parameters": [
          {
            "name": "name",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Name"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true,
                  "title": "Response Get Recipe"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      },
      "put": {
        "tags": [
          "recipes"
        ],
        "summary": "Save Recipe",
        "operationId": "save_recipe",
        "parameters": [
          {
            "name": "name",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Name"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SaveRecipeRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true,
                  "title": "Response Save Recipe"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/jobs/recipe": {
      "post": {
        "tags": [
          "recipes"
        ],
        "summary": "Submit Recipe Job",
        "operationId": "submit_recipe_job",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RecipeJobRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/agent/session": {
      "post": {
        "tags": [
          "agent"
        ],
        "summary": "Create Session",
        "operationId": "create_session_agent_session_post",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CreateSessionResponse"
                }
              }
            }
          }
        }
      }
    },
    "/agent/title": {
      "post": {
        "tags": [
          "agent"
        ],
        "summary": "Generate Title",
        "description": "Generate a short conversational title from the first user message.",
        "operationId": "generate_title_agent_title_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/GenerateTitleRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GenerateTitleResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/agent/session/{session_id}/message": {
      "post": {
        "tags": [
          "agent"
        ],
        "summary": "Send Message",
        "operationId": "send_message_agent_session__session_id__message_post",
        "parameters": [
          {
            "name": "session_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Session Id"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SendMessageRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ChatResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/health": {
      "get": {
        "summary": "Health",
        "operationId": "health",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/config": {
      "get": {
        "summary": "Get Config",
        "operationId": "get_config",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ConfigResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ChatResponse": {
        "properties": {
          "info": {
            "$ref": "#/components/schemas/ResponseInfo"
          },
          "parts": {
            "items": {
              "$ref": "#/components/schemas/ResponsePart"
            },
            "type": "array",
            "title": "Parts"
          }
        },
        "type": "object",
        "required": [
          "info",
          "parts"
        ],
        "title": "ChatResponse"
      },
      "ComputeSpec": {
        "properties": {
          "backend": {
            "type": "string",
            "title": "Backend",
            "description": "Compute backend name",
            "default": "local"
          },
          "gpus": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Gpus",
            "description": "Number of GPUs requested",
            "default": 0
          },
          "gpu_type": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Gpu Type",
            "description": "GPU type (e.g. 'A100', 'H100')"
          }
        },
        "type": "object",
        "title": "ComputeSpec"
      },
      "ConfigResponse": {
        "properties": {
          "version": {
            "type": "string",
            "title": "Version",
            "default": "1.0.0"
          },
          "default_compute_backend": {
            "type": "string",
            "title": "Default Compute Backend",
            "default": ""
          },
          "compute_namespace": {
            "type": "string",
            "title": "Compute Namespace",
            "default": ""
          },
          "mlflow_tracking_uri": {
            "type": "string",
            "title": "Mlflow Tracking Uri",
            "default": ""
          },
          "mlflow_gateway_uri": {
            "type": "string",
            "title": "Mlflow Gateway Uri",
            "default": ""
          },
          "image_registry": {
            "type": "string",
            "title": "Image Registry",
            "default": ""
          },
          "available_backends": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Available Backends"
          }
        },
        "type": "object",
        "title": "ConfigResponse"
      },
      "CreateSessionResponse": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          }
        },
        "type": "object",
        "required": [
          "id"
        ],
        "title": "CreateSessionResponse"
      },
      "GenerateTitleRequest": {
        "properties": {
          "message": {
            "type": "string",
            "title": "Message"
          }
        },
        "type": "object",
        "required": [
          "message"
        ],
        "title": "GenerateTitleRequest"
      },
      "GenerateTitleResponse": {
        "properties": {
          "title": {
            "type": "string",
            "title": "Title"
          }
        },
        "type": "object",
        "required": [
          "title"
        ],
        "title": "GenerateTitleResponse"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HealthResponse": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status"
          },
          "timestamp": {
            "type": "string",
            "title": "Timestamp"
          },
          "gpu": {
            "additionalProperties": true,
            "type": "object",
            "title": "Gpu"
          }
        },
        "type": "object",
        "required": [
          "status",
          "timestamp"
        ],
        "title": "HealthResponse"
      },
      "Job": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "type": {
            "$ref": "#/components/schemas/JobType"
          },
          "status": {
            "$ref": "#/components/schemas/JobStatus",
            "default": "queued"
          },
          "config": {
            "additionalProperties": true,
            "type": "object",
            "title": "Config"
          },
          "recipe": {
            "type": "string",
            "title": "Recipe",
            "default": ""
          },
          "parent_job_id": {
            "type": "string",
            "title": "Parent Job Id",
            "default": ""
          },
          "user_id": {
            "type": "string",
            "title": "User Id",
            "default": ""
          },
          "k8s_job_name": {
            "type": "string",
            "title": "K8S Job Name",
            "default": ""
          },
          "k8s_namespace": {
            "type": "string",
            "title": "K8S Namespace",
            "default": ""
          },
          "mlflow_run_id": {
            "type": "string",
            "title": "Mlflow Run Id",
            "default": ""
          },
          "mlflow_experiment": {
            "type": "string",
            "title": "Mlflow Experiment",
            "default": ""
          },
          "error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error"
          },
          "created_at": {
            "type": "string",
            "title": "Created At"
          },
          "started_at": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Started At"
          },
          "completed_at": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Completed At"
          }
        },
        "type": "object",
        "required": [
          "type"
        ],
        "title": "Job"
      },
      "JobRequest": {
        "properties": {
          "type": {
            "$ref": "#/components/schemas/JobType",
            "description": "Job type: training, sdg, eval"
          },
          "config": {
            "additionalProperties": true,
            "type": "object",
            "title": "Config",
            "description": "Job-type-specific configuration"
          },
          "recipe": {
            "type": "string",
            "title": "Recipe",
            "description": "Recipe name if used",
            "default": ""
          },
          "parent_job_id": {
            "type": "string",
            "title": "Parent Job Id",
            "description": "Parent job ID for lineage",
            "default": ""
          },
          "compute": {
            "$ref": "#/components/schemas/ComputeSpec"
          },
          "dry_run": {
            "type": "boolean",
            "title": "Dry Run",
            "description": "Validate without creating the job",
            "default": false
          }
        },
        "type": "object",
        "required": [
          "type",
          "config"
        ],
        "title": "JobRequest"
      },
      "JobStatus": {
        "type": "string",
        "enum": [
          "queued",
          "provisioning",
          "running",
          "succeeded",
          "failed",
          "cancelled"
        ],
        "title": "JobStatus"
      },
      "JobType": {
        "type": "string",
        "enum": [
          "training",
          "sdg",
          "eval"
        ],
        "title": "JobType"
      },
      "MessagePart": {
        "properties": {
          "type": {
            "type": "string",
            "title": "Type"
          },
          "text": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Text"
          }
        },
        "type": "object",
        "required": [
          "type"
        ],
        "title": "MessagePart"
      },
      "RecipeJobRequest": {
        "properties": {
          "recipe": {
            "type": "string",
            "title": "Recipe",
            "description": "Recipe name (e.g. 'models/qwen-1.5b-lora')"
          },
          "overrides": {
            "additionalProperties": true,
            "type": "object",
            "title": "Overrides",
            "description": "Dot-notation overrides"
          },
          "dry_run": {
            "type": "boolean",
            "title": "Dry Run",
            "description": "Validate without creating the job",
            "default": false
          }
        },
        "type": "object",
        "required": [
          "recipe"
        ],
        "title": "RecipeJobRequest"
      },
      "RecipeSummary": {
        "properties": {
          "name": {
            "type": "string",
            "title": "Name"
          },
          "description": {
            "type": "string",
            "title": "Description",
            "default": ""
          },
          "type": {
            "type": "string",
            "title": "Type",
            "default": ""
          },
          "config": {
            "additionalProperties": true,
            "type": "object",
            "title": "Config"
          }
        },
        "type": "object",
        "required": [
          "name"
        ],
        "title": "RecipeSummary"
      },
      "ResponseInfo": {
        "properties": {
          "providerID": {
            "type": "string",
            "title": "Providerid",
            "default": ""
          },
          "modelID": {
            "type": "string",
            "title": "Modelid",
            "default": ""
          },
          "cost": {
            "type": "number",
            "title": "Cost",
            "default": 0.0
          },
          "tokens": {
            "$ref": "#/components/schemas/TokenInfo",
            "default": {
              "input": 0,
              "output": 0,
              "reasoning": 0
            }
          },
          "finish": {
            "type": "string",
            "title": "Finish",
            "default": "stop"
          },
          "id": {
            "type": "string",
            "title": "Id",
            "default": ""
          },
          "sessionID": {
            "type": "string",
            "title": "Sessionid",
            "default": ""
          }
        },
        "type": "object",
        "title": "ResponseInfo"
      },
      "ResponsePart": {
        "properties": {
          "type": {
            "type": "string",
            "title": "Type"
          },
          "text": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Text"
          },
          "tool": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Tool"
          },
          "callID": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Callid"
          },
          "state": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
