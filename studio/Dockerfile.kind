# Studio frontend source lives in a separate repository.
# This Dockerfile assumes it is built from that repo's root where
# package.json and the full source tree are present.
FROM node:22-alpine AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
COPY . .
# Optional SPA base path (e.g. /amortized-studio-embed) for serving behind the
# RHOAI dashboard proxy. Defaults to "/" (standalone/kind).
ARG VITE_BASE_PATH=""
ENV VITE_BASE_PATH=$VITE_BASE_PATH
RUN npm run build

FROM nginxinc/nginx-unprivileged:alpine
COPY --from=build /app/dist /usr/share/nginx/html
COPY nginx.conf.template /etc/nginx/templates/default.conf.template
EXPOSE 8080
