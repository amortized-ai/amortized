{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EvalJobConfig",
  "description": "Configuration for evaluating a served model",
  "type": "object",
  "required": ["dataset"],
  "properties": {
    "dataset": {
      "type": "string",
      "description": "Path to test dataset (JSONL with messages + ground truth fields)"
    },
    "model_endpoint": {
      "type": "string",
      "description": "OpenAI-compatible API base URL (e.g. http://127.0.0.1:8000/v1)"
    },
    "model_name": {
      "type": "string",
      "description": "Model name as registered in the serving endpoint"
    },
    "max_samples": {
      "type": "integer",
      "minimum": 1,
      "description": "Maximum number of samples to evaluate"
    },
    "deterministic_checks": {
      "type": "array",
      "description": "List of deterministic checks to run on each result",
      "items": {
        "type": "object",
        "required": ["field", "type"],
        "properties": {
          "field": {"type": "string"},
          "type": {"type": "string", "enum": ["exact_match", "contains", "enum_match"]},
          "values": {"type": "array", "items": {"type": "string"}},
          "allowed": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "judge": {
      "type": "object",
      "description": "LLM-as-judge configuration",
      "properties": {
        "model": {"type": "string"},
        "temperature": {"type": "number", "minimum": 0.0, "default": 0.0},
        "prompt": {"type": "string"}
      }
    },
    "metrics": {
      "type": "array",
      "items": {"type": "string"},
      "description": "Metrics to report"
    },
    "temperature": {
      "type": "number",
      "minimum": 0.0,
      "default": 0.0,
      "description": "Temperature for model inference"
    }
  },
  "additionalProperties": true
}
