{
  "type": "sdg",
  "config": {
    "document_ids": ["<DOCUMENT_ID>"],
    "num_records": 100,
    "seed_config": {
      "source": {
        "chunk_size": 2048,
        "chunk_overlap": 256,
        "tokenizer": "cl100k_base"
      }
    },
    "model_configs": [
      {
        "alias": "text",
        "model": "gpt-oss",
        "provider": "gateway",
        "skip_health_check": true,
        "inference_parameters": {
          "temperature": 0.7,
          "max_parallel_requests": 32
        }
      }
    ],
    "columns": [
      {
        "column_type": "sampler",
        "name": "difficulty",
        "sampler_type": "category",
        "params": {
          "values": ["Basic", "Intermediate", "Advanced"],
          "weights": [0.35, 0.45, 0.20]
        }
      },
      {
        "column_type": "sampler",
        "name": "question_type",
        "sampler_type": "category",
        "params": {
          "values": ["Factual", "Procedural", "Troubleshooting", "Comparison"],
          "weights": [0.25, 0.35, 0.25, 0.15]
        }
      },
      {
        "column_type": "sampler",
        "name": "topic",
        "sampler_type": "category",
        "params": {
          "values": ["<TOPIC_1>", "<TOPIC_2>", "<TOPIC_3>"],
          "weights": [0.33, 0.34, 0.33]
        }
      },
      {
        "column_type": "llm-text",
        "name": "question",
        "model_alias": "text",
        "system_prompt": "You generate specific, realistic questions about the documentation. The question MUST be fully answerable using ONLY the provided context. Output ONLY the question.",
        "prompt": "Documentation context:\n{{ content }}\n\nTopic: {{ topic }}\nDifficulty: {{ difficulty }}\nQuestion type: {{ question_type }}"
      },
      {
        "column_type": "llm-text",
        "name": "answer",
        "model_alias": "text",
        "system_prompt": "Answer accurately based on the documentation context. Include specific commands, YAML snippets, and step-by-step instructions when relevant. The question is answerable from the provided context. Output ONLY the answer.",
        "prompt": "Documentation context:\n{{ content }}\n\nQuestion: {{ question }}"
      }
    ],
    "processors": [
      {
        "processor_type": "schema_transform",
        "name": "sft_format",
        "template": {
          "messages": [
            {
              "role": "system",
              "content": "<SYSTEM_PROMPT>"
            },
            {
              "role": "user",
              "content": "{{ question }}"
            },
            {
              "role": "assistant",
              "content": "{{ answer }}"
            }
          ]
        }
      }
    ]
  }
}
