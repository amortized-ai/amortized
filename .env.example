# Amortized server configuration
# Copy this file to .env and edit as needed.
# All variables use the AMORTIZED_ prefix.

# ── Database ──────────────────────────────────
AMORTIZED_DATABASE_URL=postgresql://amortized:amortized@localhost:5432/amortized

# ── Compute ───────────────────────────────────
# Backend: local, ssh, or kubernetes
AMORTIZED_COMPUTE_BACKEND=local
# K8s namespace for job pods (kubernetes backend only)
AMORTIZED_COMPUTE_NAMESPACE=amortized-jobs
# Container image registry for job images
AMORTIZED_IMAGE_REGISTRY=ghcr.io/amortized-ai

# ── MLflow ────────────────────────────────────
# MLflow tracking server URL (leave empty to disable MLflow integration)
AMORTIZED_MLFLOW_TRACKING_URI=http://localhost:5000
# MLflow AI Gateway URL for LLM routing
AMORTIZED_GATEWAY_URL=

# ── S3 / MinIO ───────────────────────────────
# S3 bucket for artifact storage
AMORTIZED_S3_BUCKET=amortized
# For MinIO, set these standard AWS env vars:
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_S3_ENDPOINT=http://localhost:9000

# ── Server ────────────────────────────────────
# API key for authentication (leave empty to disable auth)
AMORTIZED_API_KEY=
# Externally reachable server URL
AMORTIZED_EXTERNAL_URL=http://localhost:8000
