{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TrainingJobConfig",
  "description": "Configuration for a training job.",
  "type": "object",
  "required": ["algorithm", "model_path", "data_path"],
  "additionalProperties": true,
  "properties": {
    "algorithm": {
      "type": "string",
      "enum": ["lora_sft", "full_sft", "dpo", "grpo"],
      "description": "Training algorithm"
    },
    "model_path": {
      "type": "string",
      "description": "HuggingFace model path or local path"
    },
    "data_path": {
      "type": "string",
      "description": "Path to training data (JSONL)"
    },
    "ckpt_output_dir": {
      "type": "string",
      "description": "Directory for checkpoints and outputs"
    },
    "learning_rate": {
      "type": ["number", "string"],
      "description": "Learning rate (default: 2e-4)"
    },
    "bf16": {
      "type": "boolean",
      "description": "Use bfloat16 mixed precision"
    },
    "num_epochs": {
      "type": "integer",
      "minimum": 1,
      "description": "Number of training epochs"
    },
    "lora_r": {
      "type": "integer",
      "minimum": 1,
      "description": "LoRA rank"
    },
    "lora_alpha": {
      "type": "integer",
      "minimum": 1,
      "description": "LoRA alpha"
    },
    "load_in_4bit": {
      "type": "boolean",
      "description": "Enable QLoRA 4-bit quantization"
    },
    "micro_batch_size": {
      "type": "integer",
      "minimum": 1,
      "description": "Micro batch size"
    },
    "batch_size": {
      "type": "integer",
      "minimum": 1,
      "description": "Training batch size"
    },
    "max_seq_len": {
      "type": "integer",
      "minimum": 1,
      "description": "Maximum sequence length"
    },
    "gradient_checkpointing": {
      "type": "boolean",
      "description": "Enable gradient checkpointing to reduce VRAM"
    },
    "model_max_length": {
      "type": "integer",
      "minimum": 1,
      "description": "Maximum model sequence length"
    }
  }
}
