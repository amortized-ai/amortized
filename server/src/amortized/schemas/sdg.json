{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SynthJobConfig",
  "description": "Configuration for a synthetic data generation job.",
  "type": "object",
  "required": ["model"],
  "properties": {
    "model": {
      "type": "string",
      "description": "Teacher model for generation (LiteLLM format, e.g. openai/gpt-4o)"
    },
    "api_base": {
      "type": "string",
      "description": "Model API base URL (optional)"
    },
    "api_key": {
      "type": "string",
      "description": "Model API key (optional)"
    },
    "num_samples": {
      "type": "integer",
      "minimum": 1,
      "default": 100,
      "description": "Number of samples to generate"
    },
    "max_concurrency": {
      "type": "integer",
      "minimum": 1,
      "default": 16,
      "description": "Max concurrent LLM requests"
    },
    "temperature": {
      "type": "number",
      "minimum": 0,
      "maximum": 2,
      "default": 0.7
    },
    "max_tokens": {
      "type": "integer",
      "minimum": 1,
      "description": "Max tokens per LLM response"
    },
    "top_p": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "description": "Nucleus sampling parameter"
    },
    "seed": {
      "type": "integer",
      "description": "Random seed for reproducibility"
    },
    "num_retries": {
      "type": "integer",
      "minimum": 0,
      "description": "Number of LLM retries"
    },
    "input_data": {
      "type": "array",
      "items": {"type": "object"},
      "description": "Input dataset source configs"
    },
    "input_documents": {
      "type": "array",
      "items": {"type": "object"},
      "description": "Input document source configs"
    },
    "strategy_params": {
      "type": "object",
      "description": "Synthesis strategy configuration — defines what data to generate",
      "additionalProperties": true,
      "properties": {
        "sampled_attributes": {
          "type": "array",
          "description": "Attributes sampled from discrete distributions",
          "items": {
            "type": "object",
            "required": ["id", "name", "description", "possible_values"],
            "properties": {
              "id": {"type": "string", "description": "Unique attribute ID, used as {id} placeholder in prompts"},
              "name": {"type": "string", "description": "Display name"},
              "description": {"type": "string", "description": "What this attribute represents"},
              "possible_values": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["id", "name", "description"],
                  "properties": {
                    "id": {"type": "string"},
                    "name": {"type": "string", "description": "Value name, referenced as {attribute_id} in prompts"},
                    "description": {"type": "string", "description": "Value description, referenced as {attribute_id.description}"},
                    "sample_rate": {"type": "number", "minimum": 0, "maximum": 1, "description": "Sampling weight"}
                  }
                }
              }
            }
          }
        },
        "generated_attributes": {
          "type": "array",
          "description": "Attributes generated by LLM calls",
          "items": {
            "type": "object",
            "required": ["id", "instruction_messages"],
            "properties": {
              "id": {"type": "string", "description": "Unique attribute ID for the generated output"},
              "instruction_messages": {
                "type": "array",
                "description": "Messages sent to the LLM. Use {attribute_id} placeholders.",
                "items": {
                  "type": "object",
                  "required": ["role", "content"],
                  "properties": {
                    "role": {"type": "string", "enum": ["system", "user", "assistant"]},
                    "content": {"type": "string"}
                  }
                }
              },
              "postprocessing_params": {
                "type": "object",
                "description": "Post-process the LLM response",
                "properties": {
                  "id": {"type": "string"},
                  "cut_prefix": {"type": "string"},
                  "cut_suffix": {"type": "string"},
                  "regex": {"type": "string"},
                  "strip_whitespace": {"type": "boolean"}
                }
              }
            }
          }
        },
        "transformed_attributes": {
          "type": "array",
          "description": "Transform generated attributes into output formats (string, list, dict, chat)",
          "items": {"type": "object"}
        },
        "multiturn_attributes": {
          "type": "array",
          "description": "Multi-turn conversation generation with tool-use support",
          "items": {"type": "object"}
        },
        "passthrough_attributes": {
          "type": "array",
          "items": {"type": "string"},
          "description": "Which attribute IDs to include in the final output"
        },
        "input_data": {
          "type": "array",
          "description": "Input dataset sources",
          "items": {"type": "object"}
        },
        "input_documents": {
          "type": "array",
          "description": "Input document sources (PDF, DOCX, TXT)",
          "items": {"type": "object"}
        },
        "input_examples": {
          "type": "array",
          "description": "Inline example data",
          "items": {"type": "object"}
        }
      }
    }
  }
}
