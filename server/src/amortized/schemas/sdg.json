{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SDGJobConfig",
  "description": "Configuration for a synthetic data generation job.",
  "type": "object",
  "required": ["flow_id", "dataset_path", "model"],
  "additionalProperties": false,
  "properties": {
    "flow_id": {
      "type": "string",
      "description": "SDG flow identifier"
    },
    "dataset_path": {
      "type": "string",
      "description": "Path to input dataset"
    },
    "model": {
      "type": "string",
      "description": "Teacher model name (e.g. openai/gpt-4o)"
    },
    "api_base": {
      "type": "string",
      "description": "Teacher model API base URL"
    },
    "api_key": {
      "type": "string",
      "description": "Teacher model API key"
    },
    "runtime_params": {
      "type": "object",
      "description": "Per-block runtime parameter overrides"
    }
  }
}
