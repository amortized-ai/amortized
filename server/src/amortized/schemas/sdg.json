{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SynthJobConfig",
  "description": "Configuration for a synthetic data generation job.",
  "type": "object",
  "required": ["model"],
  "properties": {
    "model": {
      "type": "string",
      "description": "Teacher model for generation (LiteLLM format, e.g. openai/gpt-4o)"
    },
    "api_base": {
      "type": "string",
      "description": "Model API base URL (optional)"
    },
    "api_key": {
      "type": "string",
      "description": "Model API key (optional)"
    },
    "num_samples": {
      "type": "integer",
      "minimum": 1,
      "default": 100,
      "description": "Number of samples to generate"
    },
    "max_concurrency": {
      "type": "integer",
      "minimum": 1,
      "default": 16,
      "description": "Max concurrent LLM requests"
    },
    "temperature": {
      "type": "number",
      "minimum": 0,
      "maximum": 2,
      "default": 0.7
    },
    "max_tokens": {
      "type": "integer",
      "minimum": 1,
      "description": "Max tokens per LLM response"
    },
    "top_p": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "description": "Nucleus sampling parameter"
    },
    "seed": {
      "type": "integer",
      "description": "Random seed for reproducibility"
    },
    "num_retries": {
      "type": "integer",
      "minimum": 0,
      "description": "Number of LLM retries"
    },
    "input_data": {
      "type": "array",
      "items": {"type": "object"},
      "description": "Input dataset source configs"
    },
    "input_documents": {
      "type": "array",
      "items": {"type": "object"},
      "description": "Input document source configs"
    },
    "strategy_params": {
      "type": "object",
      "description": "Raw asynth GeneralSynthesisParams (advanced)"
    }
  }
}
